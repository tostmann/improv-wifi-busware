# Build artifacts
build/
.pio/
*.pio/
*.elf
*.hex
*.map
*.o
*.a

# Built firmware artifacts: ignore by default, but keep the curated factory
# images that ship with the test landing page in html/firmware/.
*.bin
!html/firmware/**/*.bin

# ESP-IDF generated files (regenerated on every build)
sdkconfig
sdkconfig.old
dependencies.lock
managed_components/

# Python bytecode cache
__pycache__/
*.pyc
*.pyo

# Editor / OS
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# AI agent local state -- these are personal/operational notes and must
# NOT land in the public repo.
CLAUDE.md
GEMINI.md
.claudeignore
.geminignore
MEMORY.md

# NIEMALS in Git (projekt-übergreifende Regel, 2026-05-19):
# Agent-Guidance, interne Notizen, Secrets, Logs, fremde Datenblätter
# und urheberrechtlich geschützte Schematics dürfen weder lokal noch
# auf einem Remote landen.
FACTS.md
HARDWARE_STATUS.md
.env
.env.*
*.key
*.pem
*.log
schematics/
datasheets/
datasheet/
